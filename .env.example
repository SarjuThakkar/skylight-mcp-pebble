# Your ourskylight.com login.
SKYLIGHT_EMAIL=you@example.com
SKYLIGHT_PASSWORD=changeme

# From app.ourskylight.com/calendar/<id> while logged in.
SKYLIGHT_FRAME_ID=1234567

# IANA timezone naive event times are interpreted in. Optional, defaults to
# America/Chicago.
SKYLIGHT_TIMEZONE=America/Chicago

# A Skylight family member's profile name (must match a category label on
# your calendar). Used when the `who` argument is omitted, and what
# "me"/"myself"/"i" resolve to. Optional -- leave unset for no default tag.
SKYLIGHT_DEFAULT_MEMBER=

# Static bearer token Pebble must send as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=generate-a-random-token-here
